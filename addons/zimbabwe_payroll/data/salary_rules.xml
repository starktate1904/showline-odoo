        <!-- Seq 600: Taxable Income -->
        <record id="rule_taxable_income" model="hr.salary.rule">
            <field name="name">Taxable Income</field>
            <field name="code">TAXABLE_INC</field>
            <field name="sequence">600</field>
            <field name="struct_id" ref="structure_zimbabwe_payroll"/>
            <field name="category_id" ref="hr_payroll.NET"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
gross = result_rules['GROSS_TAXABLE']['total']
allowable = abs(categories['ALLOW_DED'])
result = max(gross - allowable, 0)
]]></field>
