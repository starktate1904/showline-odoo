            <field name="category_id" ref="category_taxable_income"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = payslip._get_input_line_amount('HOUSE_ALLOW')</field>
        </record>

        <record id="nst_rule_bonus" model="hr.salary.rule">
            <field name="name">Bonus</field>
            <field name="code">BONUS</field>
            <field name="sequence">220</field>
            <field name="struct_id" ref="structure_zimbabwe_payroll_no_nssa_nec_zimdef"/>
            <field name="category_id" ref="category_bonus"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = payslip._get_input_line_amount('BONUS')</field>
        </record>

        <record id="nst_rule_loan_interest_income" model="hr.salary.rule">
            <field name="name">Loan Interest Income</field>
            <field name="code">LOAN_INT</field>
            <field name="sequence">230</field>
            <field name="struct_id" ref="structure_zimbabwe_payroll_no_nssa_nec_zimdef"/>
            <field name="category_id" ref="category_taxable_income"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = payslip._get_input_line_amount('LOAN_INT')</field>
        </record>

        <record id="nst_rule_gross_taxable" model="hr.salary.rule">
            <field name="name">Gross Taxable Income</field>
            <field name="code">GROSS_TAXABLE</field>
