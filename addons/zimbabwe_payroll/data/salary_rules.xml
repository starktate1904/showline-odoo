            <field name="struct_id" ref="structure_zimbabwe_payroll"/>
            <field name="category_id" ref="category_medical_aid"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = -payslip._get_input_line_amount('MEDICAL_AID')</field>
        </record>

