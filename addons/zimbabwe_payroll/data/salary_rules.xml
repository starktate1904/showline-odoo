            <field name="code">BASIC</field>
            <field name="sequence">100</field>
            <field name="struct_id" ref="structure_zimbabwe_payroll_no_nssa_nec_zimdef"/>
            <field name="category_id" ref="category_taxable_income"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = payslip.version_id.contract_wage if payslip.version_id else 0.0</field>
        </record>

        <record id="nst_rule_allowance" model="hr.salary.rule">
            <field name="name">Allowance</field>
