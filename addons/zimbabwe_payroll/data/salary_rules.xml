        </record>

        <record id="nst_rule_paye" model="hr.salary.rule">
            <field name="name">PAYE (Income Tax)</field>
            <field name="code">PAYE</field>
            <field name="sequence">800</field>
            <field name="struct_id" ref="structure_zimbabwe_payroll_no_nssa_nec_zimdef"/>
            <field name="category_id" ref="category_paye"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
taxable = result_rules['TAXABLE_INC']['total']
currency = payslip.currency_id or payslip.env.company.currency_id
table = payslip.env['zimra.tax.table'].search([
    ('currency_id', '=', currency.id),
    ('frequency', '=', 'monthly'),
    ('min_income', '<=', taxable),
    '|', ('max_income', '>=', taxable), ('max_income', '=', 0),
    ('active', '=', True),
], limit=1, order='effective_date desc, min_income desc')
if table:
    tax_before_credits = max((taxable * table.rate / 100.0) - table.deduction, 0)
    final_tax = max(tax_before_credits - result_rules['TOT_CREDITS']['total'], 0)
    result = -final_tax
else:
    result = 0
]]></field>
        </record>

