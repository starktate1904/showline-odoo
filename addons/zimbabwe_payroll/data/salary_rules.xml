        </record>

        <!-- Seq 301: Gross for Odoo payslip gross_wage (code GROSS) -->
        <record id="rule_gross_reporting" model="hr.salary.rule">
            <field name="name">Gross Taxable (reporting)</field>
            <field name="code">GROSS</field>
            <field name="sequence">301</field>
            <field name="struct_id" ref="structure_zimbabwe_payroll"/>
            <field name="category_id" ref="hr_payroll.GROSS"/>
            <field name="appears_on_payslip" eval="False"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = result_rules['GROSS_TAXABLE']['total']</field>
        </record>

        <!-- Seq 400: NSSA -->
        <record id="rule_nssa" model="hr.salary.rule">
            <field name="name">NSSA Contribution</field>
            <field name="code">NSSA</field>
            <field name="sequence">400</field>
            <field name="struct_id" ref="structure_zimbabwe_payroll"/>
            <field name="category_id" ref="category_nssa"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
ceiling = float(payslip.env['ir.config_parameter'].sudo().get_param('zimbabwe_payroll.nssa_ceiling', '700'))
pct = float(payslip.env['ir.config_parameter'].sudo().get_param('zimbabwe_payroll.nssa_employee_pct', '4.5'))
cap = float(payslip.env['ir.config_parameter'].sudo().get_param('zimbabwe_payroll.nssa_employee_cap', '0'))
basic = result_rules['BASIC']['total'] or (payslip.version_id.contract_wage if payslip.version_id else 0.0)
pensionable = min(basic, ceiling) if ceiling > 0 else basic
deduction = pensionable * pct / 100.0
if cap > 0:
    deduction = min(deduction, cap)
result = -deduction
]]></field>
        </record>

        <!-- Seq 401: NSSA (Employer Portion) -->
        <record id="rule_nssa_er" model="hr.salary.rule">
            <field name="name">NSSA Employer Contribution</field>
            <field name="code">NSSA_ER</field>
            <field name="sequence">401</field>
            <field name="struct_id" ref="structure_zimbabwe_payroll"/>
            <field name="category_id" ref="hr_payroll.COMP"/>
            <field name="appears_on_payslip" eval="False"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
ceiling = float(payslip.env['ir.config_parameter'].sudo().get_param('zimbabwe_payroll.nssa_ceiling', '700'))
pct = float(payslip.env['ir.config_parameter'].sudo().get_param('zimbabwe_payroll.nssa_employer_pct', '4.5'))
basic = result_rules['BASIC']['total'] or (payslip.version_id.contract_wage if payslip.version_id else 0.0)
pensionable = min(basic, ceiling) if ceiling > 0 else basic
result = (pensionable * pct / 100.0)
]]></field>
        </record>

        <!-- Seq 410: NEC -->
        <record id="rule_nec" model="hr.salary.rule">
            <field name="name">NEC Contribution</field>
            <field name="code">NEC</field>
            <field name="sequence">410</field>
            <field name="struct_id" ref="structure_zimbabwe_payroll"/>
            <field name="category_id" ref="category_nec"/>
            <field name="appears_on_payslip" eval="True"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
total_pct = float(payslip.env['ir.config_parameter'].sudo().get_param('zimbabwe_payroll.nec_total_pct', '2.5'))
emp_split = float(payslip.env['ir.config_parameter'].sudo().get_param('zimbabwe_payroll.nec_employee_split', '50.0'))
pct = total_pct * (emp_split / 100.0)
basic = result_rules['BASIC']['total'] if 'BASIC' in result_rules else 0.0
overtime = result_rules['OVERTIME']['total'] if 'OVERTIME' in result_rules else 0.0
cola = result_rules['COLA']['total'] if 'COLA' in result_rules else 0.0
backpay = result_rules['BACKPAY']['total'] if 'BACKPAY' in result_rules else 0.0
pensionable = basic + overtime + cola + backpay
result = -(pensionable * pct / 100.0)
]]></field>
        </record>

        <!-- Seq 411: NEC (Employer Portion) -->
        <record id="rule_nec_er" model="hr.salary.rule">
            <field name="name">NEC Employer Contribution</field>
            <field name="code">NEC_ER</field>
            <field name="sequence">411</field>
            <field name="struct_id" ref="structure_zimbabwe_payroll"/>
            <field name="category_id" ref="hr_payroll.COMP"/>
            <field name="appears_on_payslip" eval="False"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
total_pct = float(payslip.env['ir.config_parameter'].sudo().get_param('zimbabwe_payroll.nec_total_pct', '2.5'))
er_split = float(payslip.env['ir.config_parameter'].sudo().get_param('zimbabwe_payroll.nec_employer_split', '50.0'))
pct = total_pct * (er_split / 100.0)
basic = result_rules['BASIC']['total'] if 'BASIC' in result_rules else 0.0
overtime = result_rules['OVERTIME']['total'] if 'OVERTIME' in result_rules else 0.0
cola = result_rules['COLA']['total'] if 'COLA' in result_rules else 0.0
backpay = result_rules['BACKPAY']['total'] if 'BACKPAY' in result_rules else 0.0
pensionable = basic + overtime + cola + backpay
result = (pensionable * pct / 100.0)
]]></field>
        </record>

        <!-- Seq 420: ZIMDEF -->
        <record id="rule_zimdef" model="hr.salary.rule">
            <field name="name">ZIMDEF Contribution</field>
            <field name="code">ZIMDEF</field>
            <field name="sequence">420</field>
            <field name="struct_id" ref="structure_zimbabwe_payroll"/>
            <field name="category_id" ref="hr_payroll.COMP"/>
            <field name="appears_on_payslip" eval="False"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
basic_pct = float(payslip.env['ir.config_parameter'].sudo().get_param('zimbabwe_payroll.zimdef_basic_pct', '1.0'))
contrib_pct = float(payslip.env['ir.config_parameter'].sudo().get_param('zimbabwe_payroll.zimdef_contrib_pct', '1.0'))
gross = result_rules['GROSS']['total'] if 'GROSS' in result_rules else 0.0
nssa = abs(result_rules['NSSA']['total']) if 'NSSA' in result_rules else 0.0
nec = abs(result_rules['NEC']['total']) if 'NEC' in result_rules else 0.0
result = ((gross * basic_pct / 100.0) + ((nssa + nec) * contrib_pct / 100.0))
]]></field>
        </record>

