        <record id="rule_total_allowable_deductions" model="hr.salary.rule">
            <field name="name">Total Allowable Deductions</field>
            <field name="code">TOT_ALLOW_DED</field>
            <field name="sequence">500</field>
            <field name="struct_id" ref="structure_zimbabwe_payroll"/>
            <field name="category_id" ref="category_allowable_deduction"/>
