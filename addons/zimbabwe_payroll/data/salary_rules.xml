            <field name="struct_id" ref="structure_zimbabwe_payroll"/>
            <field name="category_id" ref="category_tax_credit"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
result = float(payslip.env['ir.config_parameter'].sudo().get_param('zimbabwe_payroll.tax_credit_disabled', '75'))
]]></field>
            <field name="condition_select">python</field>
            <field name="condition_python">result = employee.is_disabled</field>
        </record>

        <!-- Seq 790: Total Tax Credits -->
        <record id="rule_total_tax_credits" model="hr.salary.rule">
            <field name="name">Total Tax Credits</field>
            <field name="code">TOT_CREDITS</field>
            <field name="sequence">790</field>
            <field name="struct_id" ref="structure_zimbabwe_payroll"/>
            <field name="category_id" ref="category_tax_credit"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = categories['TAX_CREDIT']</field>
        </record>

        <!-- Seq 800: PAYE -->
        <record id="rule_paye" model="hr.salary.rule">
            <field name="name">PAYE (Income Tax)</field>
            <field name="code">PAYE</field>
            <field name="sequence">800</field>
            <field name="struct_id" ref="structure_zimbabwe_payroll"/>
            <field name="category_id" ref="category_paye"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
taxable = result_rules['TAXABLE_INC']['total']
currency = payslip.currency_id or payslip.env.company.currency_id
table = payslip.env['zimra.tax.table'].search([
    ('currency_id', '=', currency.id),
    ('frequency', '=', 'monthly'),
    ('min_income', '<=', taxable),
    '|', ('max_income', '>=', taxable), ('max_income', '=', 0),
    ('active', '=', True),
], limit=1, order='effective_date desc, min_income desc')
if table:
    tax_before_credits = max((taxable * table.rate / 100.0) - table.deduction, 0)
    final_tax = max(tax_before_credits - result_rules['TOT_CREDITS']['total'], 0)
    result = -final_tax
else:
    result = 0
]]></field>
        </record>

        <!-- Seq 900: AIDS Levy -->
        <record id="rule_aids_levy" model="hr.salary.rule">
            <field name="name">AIDS Levy</field>
            <field name="code">AIDS_LEVY</field>
            <field name="sequence">900</field>
            <field name="struct_id" ref="structure_zimbabwe_payroll"/>
            <field name="category_id" ref="category_aids_levy"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
pct = float(payslip.env['ir.config_parameter'].sudo().get_param('zimbabwe_payroll.aids_levy_pct', '3.0'))
paye_amount = abs(result_rules['PAYE']['total'])
result = -(paye_amount * pct / 100.0)
]]></field>
        </record>

        <!-- Seq 1000: Funeral Policy -->
        <record id="rule_funeral" model="hr.salary.rule">
            <field name="name">Funeral Policy</field>
            <field name="code">FUNERAL</field>
            <field name="sequence">1000</field>
            <field name="struct_id" ref="structure_zimbabwe_payroll"/>
            <field name="category_id" ref="category_funeral"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = -payslip._get_input_line_amount('FUNERAL')</field>
        </record>

        <!-- Seq 1010: Loan Repayment -->
        <record id="rule_loan" model="hr.salary.rule">
            <field name="name">Loan Repayment</field>
            <field name="code">LOAN</field>
            <field name="sequence">1010</field>
            <field name="struct_id" ref="structure_zimbabwe_payroll"/>
            <field name="category_id" ref="category_loan"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = -payslip._get_input_line_amount('LOAN')</field>
        </record>

        <!-- Seq 1100: Net pay (Odoo uses code NET for net_wage and PDF "Amount to be paid") -->
        <record id="rule_net_salary" model="hr.salary.rule">
            <field name="name">Net Pay</field>
            <field name="code">NET</field>
            <field name="sequence">1100</field>
            <field name="struct_id" ref="structure_zimbabwe_payroll"/>
            <field name="category_id" ref="hr_payroll.NET"/>
            <field name="appears_on_payslip" eval="False"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
# Sum only "cash" components; exclude subtotals (GROSS_TAXABLE, TOT_ALLOW_DED, TAXABLE_INC, credits, etc.)
_net_codes = [
    'BASIC', 'ALLOWANCE', 'HOUSE_ALLOW', 'BONUS', 'LOAN_INT', 'OVERTIME', 'COLA', 'BACKPAY',
    'NSSA', 'NEC', 'MEDICAL_AID', 'PAYE', 'AIDS_LEVY', 'FUNERAL', 'LOAN',
]
result = 0.0
for _code in _net_codes:
    if _code in result_rules:
        result += result_rules[_code]['total']
]]></field>
        </record>

    </data>

    <!-- Same Zimbabwe logic but without NSSA, NEC, or ZIMDEF (e.g. employees exempt / not in scope) -->
    <data noupdate="0">

