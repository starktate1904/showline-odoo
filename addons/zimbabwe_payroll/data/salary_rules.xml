            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
pct = float(payslip.env['ir.config_parameter'].sudo().get_param('zimbabwe_payroll.medical_aid_tax_credit_pct', '50'))
ceiling = float(payslip.env['ir.config_parameter'].sudo().get_param('zimbabwe_payroll.medical_aid_credit_ceiling', '1000'))
med_aid_paid = abs(categories['MED_AID'])
credit = med_aid_paid * pct / 100.0
result = min(credit, ceiling)
]]></field>
