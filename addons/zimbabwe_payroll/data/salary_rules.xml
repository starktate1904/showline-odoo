        <!-- Seq 700: Medical Aid Tax Credit -->
        <record id="rule_medical_credit" model="hr.salary.rule">
            <field name="name">Medical Aid Tax Credit</field>
            <field name="code">MED_CREDIT</field>
            <field name="sequence">700</field>
            <field name="struct_id" ref="structure_zimbabwe_payroll"/>
            <field name="category_id" ref="category_tax_credit"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
pct = float(payslip.env['ir.config_parameter'].sudo().get_param('zimbabwe_payroll.medical_aid_tax_credit_pct', '50'))
ceiling = float(payslip.env['ir.config_parameter'].sudo().get_param('zimbabwe_payroll.medical_aid_credit_ceiling', '1000'))
med_aid_paid = abs(categories['MED_AID'])
credit = med_aid_paid * pct / 100.0
result = min(credit, ceiling)
]]></field>
        </record>

        <!-- Seq 710: Blind Tax Credit -->
        <record id="rule_blind_credit" model="hr.salary.rule">
            <field name="name">Blind Person Tax Credit</field>
            <field name="code">BLIND_CREDIT</field>
            <field name="sequence">710</field>
            <field name="struct_id" ref="structure_zimbabwe_payroll"/>
            <field name="category_id" ref="category_tax_credit"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
result = float(payslip.env['ir.config_parameter'].sudo().get_param('zimbabwe_payroll.tax_credit_blind', '75'))
]]></field>
            <field name="condition_select">python</field>
            <field name="condition_python">result = employee.is_blind</field>
        </record>

        <!-- Seq 720: Elderly Tax Credit -->
        <record id="rule_elderly_credit" model="hr.salary.rule">
