_net_codes = [
    'BASIC', 'ALLOWANCE', 'HOUSE_ALLOW', 'BONUS', 'LOAN_INT',
    'NSSA', 'NEC', 'ZIMDEF', 'MEDICAL_AID', 'PAYE', 'AIDS_LEVY', 'FUNERAL', 'LOAN',
