            <field name="code">ELDERLY_CREDIT</field>
            <field name="sequence">720</field>
            <field name="struct_id" ref="structure_zimbabwe_payroll"/>
            <field name="category_id" ref="category_tax_credit"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
result = float(payslip.env['ir.config_parameter'].sudo().get_param('zimbabwe_payroll.tax_credit_elderly', '75'))
]]></field>
            <field name="condition_select">python</field>
            <field name="condition_python">result = employee.is_over_65</field>
        </record>

