<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_nec_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="run">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="company" t-value="run.company_id"/>
                        <t t-set="nec" t-value="(data or {}).get('nec', {})"/>

                        <h2 style="margin-top: 10px;">NEC Payment Report</h2>
                        <p style="font-size: 12px; margin: 4px 0;">
                            Pay run: <span t-out="run.name"/> • Period: <span t-out="run.date_start"/> to <span t-out="run.date_end"/>
                        </p>

                        <table class="table table-sm" style="margin-bottom: 12px;">
                            <tr>
                                <td><strong>Employees:</strong> <span t-out="len(nec.get('employees', []))"/></td>
                                <td><strong>Total NEC base:</strong> <span t-out="nec.get('totals', {}).get('earnings_base', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                <td><strong>Employee contribution:</strong> <span t-out="nec.get('totals', {}).get('employee_nec', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                <td><strong>Total NEC payment:</strong> <span t-out="nec.get('totals', {}).get('total_nec', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                            </tr>
                        </table>

                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr style="background-color: #f5f5f5;">
                                    <th>Surname</th>
                                    <th>First Names</th>
                                    <th style="text-align: right;">Start Date</th>
                                    <th style="text-align: right;">End Date</th>
                                    <th style="text-align: right;">NEC Base</th>
                                    <th style="text-align: right;">Employee</th>
                                    <th style="text-align: right;">Employer</th>
                                    <th style="text-align: right;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="nec.get('employees', [])" t-as="emp">
                                    <tr>
                                        <td><span t-out="emp.get('surname')"/></td>
                                        <td><span t-out="emp.get('first_names')"/></td>
                                        <td style="text-align: right;"><span t-out="emp.get('start_date')"/></td>
                                        <td style="text-align: right;"><span t-out="emp.get('end_date')"/></td>
                                        <td style="text-align: right;"><span t-out="emp.get('earnings_base')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                        <td style="text-align: right;"><span t-out="emp.get('employee_nec')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                        <td style="text-align: right;"><span t-out="emp.get('employer_nec')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                        <td style="text-align: right;"><span t-out="emp.get('total_nec')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="background-color: #f0f0f0; font-weight: bold;">
                                    <td colspan="4">Grand Totals</td>
                                    <td style="text-align: right;"><span t-out="nec.get('totals', {}).get('earnings_base', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                    <td style="text-align: right;"><span t-out="nec.get('totals', {}).get('employee_nec', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                    <td style="text-align: right;"><span t-out="nec.get('totals', {}).get('employer_nec', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                    <td style="text-align: right;"><span t-out="nec.get('totals', {}).get('total_nec', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_nec" model="ir.actions.report">
        <field name="name">NEC Report</field>
        <field name="model">hr.payslip.run</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zimbabwe_payroll.report_nec_document</field>
        <field name="report_file">zimbabwe_payroll.report_nec_document</field>
    </record>
</odoo>