<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zimbabwe_payroll_report_wizard_form" model="ir.ui.view">
        <field name="name">zimbabwe.payroll.report.wizard.form</field>
        <field name="model">zimbabwe.payroll.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Payroll Report">
                <group>
                    <field name="pay_run_id" options="{'no_create': True}"/>
                    <field name="report_type" invisible="1"/>
                    <field name="format"
                           widget="radio"
                           options="{'horizontal': True}"
                           invisible="report_type in ('salary_breakdown', 'salary_summary')"/>
                </group>
                <footer>
                    <button name="action_generate" string="Generate" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_salary_breakdown_wizard" model="ir.actions.act_window">
        <field name="name">Salary Breakdown</field>
        <field name="res_model">zimbabwe.payroll.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'salary_breakdown', 'default_format': 'pdf'}</field>
    </record>

    <record id="action_salary_summary_wizard" model="ir.actions.act_window">
        <field name="name">Salary Summary</field>
        <field name="res_model">zimbabwe.payroll.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'salary_summary', 'default_format': 'pdf'}</field>
    </record>

