    <!-- Menus under hr_payroll.menu_hr_payroll_report -->
    <menuitem id="menu_report_salary_breakdown"
              name="Salary Breakdown"
              parent="hr_payroll.menu_hr_payroll_report"
              action="action_salary_breakdown_wizard"
              sequence="10"/>

