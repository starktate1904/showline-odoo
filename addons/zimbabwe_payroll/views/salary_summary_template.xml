<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_salary_summary_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="run">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="company" t-value="run.company_id"/>
                        <t t-set="summary" t-value="(data or {}).get('summary', {})"/>

                        <h2 style="margin-top: 10px;">Salary Summary</h2>
                        <p style="font-size: 12px; margin: 4px 0;">
                            Pay run: <span t-out="run.name"/> • Period: <span t-out="run.date_start"/> to <span t-out="run.date_end"/>
                        </p>
                        
                        <table class="table table-sm" style="margin-bottom: 12px;">
                            <tr>
                                <td><strong>Basic salary total:</strong> <span t-out="summary.get('basic_salary', 0.0)" t-options='{"widget": "monetary", "display_currency": run.company_id.currency_id}'/></td>
                                <td><strong>Gross wage total:</strong> <span t-out="summary.get('gross_wage', 0.0)" t-options='{"widget": "monetary", "display_currency": run.company_id.currency_id}'/></td>
                                <td><strong>Net pay total:</strong> <span t-out="summary.get('net_pay', 0.0)" t-options='{"widget": "monetary", "display_currency": run.company_id.currency_id}'/></td>
                                <td><strong>Employer costs:</strong> <span t-out="summary.get('employer_costs', 0.0)" t-options='{"widget": "monetary", "display_currency": run.company_id.currency_id}'/></td>
                            </tr>
                        </table>

                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr style="background-color: #f5f5f5;">
                                    <th>Description</th>
                                    <th style="text-align: right;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Total basic salary</td>
                                    <td style="text-align: right;"><span t-out="summary.get('basic_salary', 0.0)" t-options='{"widget": "monetary", "display_currency": run.company_id.currency_id}'/></td>
                                </tr>
                                <tr>
                                    <td>Total gross wage</td>
                                    <td style="text-align: right;"><span t-out="summary.get('gross_wage', 0.0)" t-options='{"widget": "monetary", "display_currency": run.company_id.currency_id}'/></td>
                                </tr>
                                <tr style="background-color: #d4edda; font-weight: bold;">
                                    <td>Total net pay</td>
                                    <td style="text-align: right;"><span t-out="summary.get('net_pay', 0.0)" t-options='{"widget": "monetary", "display_currency": run.company_id.currency_id}'/></td>
                                </tr>
                                <tr>
                                    <td>Total earnings</td>
                                    <td style="text-align: right;"><span t-out="summary.get('total_earnings', 0.0)" t-options='{"widget": "monetary", "display_currency": run.company_id.currency_id}'/></td>
                                </tr>
                                <tr>
                                    <td>Total deductions</td>
                                    <td style="text-align: right;"><span t-out="summary.get('total_deductions', 0.0)" t-options='{"widget": "monetary", "display_currency": run.company_id.currency_id}'/></td>
                                </tr>
                                <tr style="background-color: #f0f0f0; font-weight: bold;">
                                    <td>Employer costs</td>
                                    <td style="text-align: right;"><span t-out="summary.get('employer_costs', 0.0)" t-options='{"widget": "monetary", "display_currency": run.company_id.currency_id}'/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_salary_summary" model="ir.actions.report">
        <field name="name">Salary Summary</field>
        <field name="model">hr.payslip.run</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zimbabwe_payroll.report_salary_summary_document</field>
        <field name="report_file">zimbabwe_payroll.report_salary_summary_document</field>
    </record>
</odoo>