<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payslip" inherit_id="hr_payroll.report_payslip">
        <xpath expr="//h2[@id='payslip_name']" position="replace"/>
        <xpath expr="//div[@id='infos_table']" position="replace">
            <table class="table table-sm">
                <tr>
                    <td><strong>Employee:</strong> <span t-field="o.employee_id.name"/></td>
                    <td><strong>Period:</strong> <span t-field="o.date_from"/> to <span t-field="o.date_to"/></td>
                </tr>
                <tr>
                    <td><strong>Department:</strong> <span t-field="o.employee_id.department_id.name" default="N/A"/></td>
                    <td><strong>Designation:</strong> <span t-field="o.employee_id.job_title" default="N/A"/></td>
                </tr>
            </table>
        </xpath>
        <xpath expr="//div[@id='payslip_lines_table']//thead//tr" position="replace">
            <tr>
                <th>EARNINGS</th>
                <th style="text-align: right;">AMOUNT</th>
                <th>DEDUCTIONS</th>
                <th style="text-align: right;">AMOUNT</th>
            </tr>
        </xpath>
        <xpath expr="//div[@id='to_pay']" position="replace"/>
    </template>
</odoo>