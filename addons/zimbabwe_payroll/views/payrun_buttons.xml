<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_run_form_zimbabwe_reports" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.zimbabwe.reports</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/group" position="before">
                <header>
                    <button
                        name="action_open_salary_breakdown_pdf"
                        type="object"
                        string="Salary Breakdown"
                        class="btn-primary"
                        invisible="not id"
                    />
                    <button
                        name="action_open_salary_summary_pdf"
                        type="object"
                        string="Salary Summary"
                        class="btn-secondary"
                        invisible="not id"
                    />
                    <button
                        name="action_open_nssa_report_pdf"
                        type="object"
                        string="NSSA Report"
                        class="btn-secondary"
                        invisible="not id"
                    />
                    <button
                        name="action_open_zimra_itf_report_pdf"
                        type="object"
                        string="ZIMRA ITF Report"
                        class="btn-secondary"
                        invisible="not id"
                    />
                </header>
            </xpath>
        </field>
    </record>

    <record id="view_hr_payslip_tree_zimbabwe_reports" model="ir.ui.view">
        <field name="name">hr.payslip.tree.zimbabwe.reports</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/header" position="inside">
                <button
                    name="action_open_run_salary_breakdown_pdf"
                    type="object"
                    string="Salary Breakdown"
                    class="btn-secondary"
                />
                <button
                    name="action_open_run_salary_summary_pdf"
                    type="object"
                    string="Salary Summary"
                    class="btn-secondary"
                />
                <button
                    name="action_open_run_nssa_report_pdf"
                    type="object"
                    string="NSSA Report"
                    class="btn-secondary"
                />
                <button
                    name="action_open_run_zimra_itf_report_pdf"
                    type="object"
                    string="ZIMRA ITF Report"
                    class="btn-secondary"
                />
            </xpath>
        </field>
    </record>
</odoo>
