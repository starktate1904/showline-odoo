<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_nssa_p4_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="run">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="company" t-value="run.company_id"/>
                        <t t-set="nssa" t-value="(data or {}).get('nssa', {})"/>

                        <h2 style="margin-top: 10px;">NSSA P4 Contribution Report</h2>
                        <p style="font-size: 12px; margin: 4px 0;">
                            Pay run: <span t-out="run.name"/> - Period: <span t-out="run.date_start"/> to <span t-out="run.date_end"/>
                        </p>

                        <table class="table table-sm" style="margin-bottom: 12px;">
                            <tr>
                                <td><strong>Employees:</strong> <span t-out="len(nssa.get('employees', []))"/></td>
                                <td><strong>Total Insurable Earnings:</strong> <span t-out="nssa.get('totals', {}).get('total_insurable_earnings', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                <td><strong>Total Payment:</strong> <span t-out="nssa.get('totals', {}).get('total_payment', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                <td><strong>Employer Payment:</strong> <span t-out="nssa.get('totals', {}).get('employer_payment', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                            </tr>
                        </table>

                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr style="background-color: #f5f5f5;">
                                    <th>Surname</th>
                                    <th>First Names</th>
                                    <th style="text-align:right;">Start Date</th>
                                    <th style="text-align:right;">End Date</th>
                                    <th style="text-align:right;">Total Insurable Earnings</th>
                                    <th style="text-align:right;">Current Contributions</th>
                                    <th style="text-align:right;">Arrears</th>
                                    <th style="text-align:right;">Prepayments</th>
                                    <th style="text-align:right;">Surcharge</th>
                                    <th style="text-align:right;">Total Payment</th>
                                    <th style="text-align:right;">Employer Payment</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="nssa.get('employees', [])" t-as="emp">
                                    <tr>
                                        <td><span t-out="emp.get('surname')"/></td>
                                        <td><span t-out="emp.get('first_names')"/></td>
                                        <td style="text-align:right;"><span t-out="emp.get('start_date')"/></td>
                                        <td style="text-align:right;"><span t-out="emp.get('end_date')"/></td>
                                        <td style="text-align:right;"><span t-out="emp.get('total_insurable_earnings', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                        <td style="text-align:right;"><span t-out="emp.get('current_contribution', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                        <td style="text-align:right;"><span t-out="emp.get('arrears', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                        <td style="text-align:right;"><span t-out="emp.get('prepayments', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                        <td style="text-align:right;"><span t-out="emp.get('surcharge', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                        <td style="text-align:right;"><span t-out="emp.get('total_payment', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                        <td style="text-align:right;"><span t-out="emp.get('employer_payment', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="background-color: #f0f0f0; font-weight: bold;">
                                    <td colspan="4">Grand Totals</td>
                                    <td style="text-align:right;"><span t-out="nssa.get('totals', {}).get('total_insurable_earnings', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                    <td style="text-align:right;"><span t-out="nssa.get('totals', {}).get('current_contribution', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                    <td style="text-align:right;"><span t-out="nssa.get('totals', {}).get('arrears', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                    <td style="text-align:right;"><span t-out="nssa.get('totals', {}).get('prepayments', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                    <td style="text-align:right;"><span t-out="nssa.get('totals', {}).get('surcharge', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                    <td style="text-align:right;"><span t-out="nssa.get('totals', {}).get('total_payment', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                    <td style="text-align:right;"><span t-out="nssa.get('totals', {}).get('employer_payment', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_nssa_p4" model="ir.actions.report">
        <field name="name">NSSA P4 Report</field>
        <field name="model">hr.payslip.run</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zimbabwe_payroll.report_nssa_p4_document</field>
        <field name="report_file">zimbabwe_payroll.report_nssa_p4_document</field>
    </record>
</odoo>