<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_zimra_itf_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="run">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="company" t-value="run.company_id"/>
                        <t t-set="zimra" t-value="(data or {}).get('zimra', {})"/>
                        
                        <style>
                            .zimra-info-blocks {
                                display: flex;
                                justify-content: space-between;
                                margin-bottom: 30px;
                                margin-top: 20px;
                            }
                            .zimra-left-block {
                                width: 48%;
                                background-color: #f8f9fa;
                                padding: 15px;
                                border-radius: 4px;
                            }
                            .zimra-right-block {
                                width: 48%;
                                background-color: #2c3e50;
                                color: white;
                                padding: 15px;
                                border-radius: 4px;
                            }
                            .zimra-right-block table {
                                width: 100%;
                            }
                            .zimra-right-block td {
                                padding: 4px 0;
                            }
                            .zimra-right-block .label {
                                font-weight: bold;
                                width: 40%;
                            }
                            .zimra-left-block h5 {
                                color: #2c3e50;
                                font-weight: bold;
                                margin-top: 0;
                                margin-bottom: 10px;
                            }
                            
                            .zimra-table {
                                width: 100%;
                                margin-top: 20px;
                                font-size: 13px;
                            }
                            .zimra-table thead th {
                                background-color: #2c3e50;
                                color: white;
                                padding: 10px;
                                font-weight: bold;
                                border: none;
                            }
                            .zimra-table tbody td {
                                padding: 8px 10px;
                                border: none;
                                border-bottom: 1px solid #e9ecef;
                            }
                            .zimra-table tbody tr:nth-child(even) {
                                background-color: #f8f9fa;
                            }
                            .zimra-totals {
                                width: 100%;
                                border-top: 2px solid #2c3e50;
                                margin-top: 10px;
                                padding-top: 10px;
                                font-size: 14px;
                            }
                            .zimra-totals-row {
                                display: flex;
                                justify-content: flex-end;
                                padding: 5px 0;
                            }
                            .zimra-totals-label {
                                width: 150px;
                                font-weight: bold;
                                text-align: right;
                                padding-right: 20px;
                            }
                            .zimra-totals-value {
                                width: 150px;
                                text-align: right;
                                font-weight: bold;
                            }
                            .zimra-grand-total {
                                border-top: 1px solid #dee2e6;
                                margin-top: 5px;
                                padding-top: 5px;
                                font-size: 16px;
                            }
                        </style>

                        <div class="zimra-info-blocks">
                            <div class="zimra-left-block">
                                <h5>Report Details</h5>
                                <div><strong>Generated On:</strong> <span t-out="zimra.get('report_date', '')"/></div>
                                <div><strong>Company:</strong> <span t-out="company.name"/></div>
                                <div><strong>Currency:</strong> <span t-out="company.currency_id.name"/></div>
                            </div>
                            <div class="zimra-right-block">
                                <table>
                                    <tr>
                                        <td class="label">Report:</td>
                                        <td>ZIMRA ITF16</td>
                                    </tr>
                                    <tr>
                                        <td class="label">Pay Run:</td>
                                        <td><span t-out="run.name"/></td>
                                    </tr>
                                    <tr>
                                        <td class="label">Start Date:</td>
                                        <td><span t-out="run.date_start"/></td>
                                    </tr>
                                    <tr>
                                        <td class="label">End Date:</td>
                                        <td><span t-out="run.date_end"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <table class="zimra-table">
                            <thead>
                                <tr>
                                    <th class="text-center">ID</th>
                                    <th>Surname</th>
                                    <th>First Name</th>
                                    <th class="text-end">Basic Pension</th>
                                    <th class="text-end">Gross Pay</th>
                                    <th class="text-end">PAYE</th>
                                    <th class="text-end">AIDS Levy</th>
                                    <th class="text-end">Total Tax Due</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="zimra.get('employees', [])" t-as="emp">
                                    <tr>
                                        <td class="text-center"><span t-out="emp.get('employee_id')"/></td>
                                        <td><span t-out="emp.get('surname')"/></td>
                                        <td><span t-out="emp.get('first_names')"/></td>
                                        <td class="text-end">
                                            <span t-out="emp.get('basic')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                        <td class="text-end">
                                            <span t-out="emp.get('gross')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                        <td class="text-end">
                                            <span t-out="emp.get('paye')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                        <td class="text-end">
                                            <span t-out="emp.get('aids_levy')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                        <td class="text-end fw-bold">
                                            <span t-out="emp.get('total_tax_due')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <t t-set="totals" t-value="zimra.get('totals', {})"/>
                        
                        <div class="row mt-4">
                            <div class="col-6 offset-6">
                                <div class="zimra-totals">
                                    <div class="zimra-totals-row">
                                        <div class="zimra-totals-label">Total Gross Pay</div>
                                        <div class="zimra-totals-value">
                                            <span t-out="totals.get('gross', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </div>
                                    </div>
                                    <div class="zimra-totals-row">
                                        <div class="zimra-totals-label">Total PAYE</div>
                                        <div class="zimra-totals-value">
                                            <span t-out="totals.get('paye', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </div>
                                    </div>
                                    <div class="zimra-totals-row">
                                        <div class="zimra-totals-label">Total AIDS Levy</div>
                                        <div class="zimra-totals-value">
                                            <span t-out="totals.get('aids_levy', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </div>
                                    </div>
                                    <div class="zimra-totals-row zimra-grand-total">
                                        <div class="zimra-totals-label">TOTAL TAX DUE</div>
                                        <div class="zimra-totals-value">
                                            <span t-out="totals.get('total_tax_due', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_zimra_itf" model="ir.actions.report">
        <field name="name">ZIMRA ITF Report</field>
        <field name="model">hr.payslip.run</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zimbabwe_payroll.report_zimra_itf_document</field>
        <field name="report_file">zimbabwe_payroll.report_zimra_itf_document</field>
    </record>
</odoo>
