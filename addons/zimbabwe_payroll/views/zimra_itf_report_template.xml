<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_zimra_itf_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="run">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="company" t-value="run.company_id"/>
                        <t t-set="zimra" t-value="(data or {}).get('zimra', {})"/>

                        <h2 style="margin-top: 10px;">ZIMRA ITF16 Report</h2>
                        <p style="font-size: 12px; margin: 4px 0;">
                            Pay run: <span t-out="run.name"/> • Period: <span t-out="run.date_start"/> to <span t-out="run.date_end"/>
                        </p>

                        <table class="table table-sm" style="margin-bottom: 12px;">
                            <tr>
                                <td><strong>Employees:</strong> <span t-out="len(zimra.get('employees', []))"/></td>
                                <td><strong>Total gross pay:</strong> <span t-out="zimra.get('totals', {}).get('gross', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                <td><strong>Total PAYE:</strong> <span t-out="zimra.get('totals', {}).get('paye', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                <td><strong>Total tax due:</strong> <span t-out="zimra.get('totals', {}).get('total_tax_due', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                            </tr>
                        </table>

                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr style="background-color: #f5f5f5;">
                                    <th>ID</th>
                                    <th>Surname</th>
                                    <th>First Name</th>
                                    <th style="text-align: right;">Basic Pension</th>
                                    <th style="text-align: right;">Gross Pay</th>
                                    <th style="text-align: right;">PAYE</th>
                                    <th style="text-align: right;">AIDS Levy</th>
                                    <th style="text-align: right;">Total Tax</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="zimra.get('employees', [])" t-as="emp">
                                    <tr>
                                        <td><span t-out="emp.get('employee_id')"/></td>
                                        <td><span t-out="emp.get('surname')"/></td>
                                        <td><span t-out="emp.get('first_names')"/></td>
                                        <td style="text-align: right;"><span t-out="emp.get('basic')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                        <td style="text-align: right;"><span t-out="emp.get('gross')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                        <td style="text-align: right;"><span t-out="emp.get('paye')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                        <td style="text-align: right;"><span t-out="emp.get('aids_levy')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                        <td style="text-align: right;"><span t-out="emp.get('total_tax_due')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="background-color: #f0f0f0; font-weight: bold;">
                                    <td colspan="4">Totals</td>
                                    <td style="text-align: right;"><span t-out="zimra.get('totals', {}).get('gross', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                    <td style="text-align: right;"><span t-out="zimra.get('totals', {}).get('paye', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                    <td style="text-align: right;"><span t-out="zimra.get('totals', {}).get('aids_levy', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                    <td style="text-align: right;"><span t-out="zimra.get('totals', {}).get('total_tax_due', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_zimra_itf" model="ir.actions.report">
        <field name="name">ZIMRA ITF Report</field>
        <field name="model">hr.payslip.run</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zimbabwe_payroll.report_zimra_itf_document</field>
        <field name="report_file">zimbabwe_payroll.report_zimra_itf_document</field>
    </record>
</odoo>