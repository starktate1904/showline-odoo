<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_salary_breakdown_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="run">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="company" t-value="run.company_id"/>
                        <t t-set="bd" t-value="(data or {}).get('breakdown', {})"/>

                        <h2 style="margin-top: 10px;">Salary Breakdown</h2>
                        <p style="font-size: 12px; margin: 4px 0;">
                            Pay run: <span t-out="run.name"/> • Period: <span t-out="run.date_start"/> to <span t-out="run.date_end"/>
                        </p>
                        
                        <table class="table table-sm" style="margin-bottom: 12px;">
                            <tr>
                                <td><strong>Total employees:</strong> <span t-out="bd.get('total_employees', 0)"/></td>
                                <td><strong>Total earnings:</strong> <span t-out="bd.get('total_earnings', 0.0)" t-options='{"widget": "monetary", "display_currency": run.company_id.currency_id}'/></td>
                                <td><strong>Total deductions:</strong> <span t-out="bd.get('total_deductions', 0.0)" t-options='{"widget": "monetary", "display_currency": run.company_id.currency_id}'/></td>
                                <td><strong>Net pay:</strong> <span t-out="(bd.get('total_earnings', 0.0) - bd.get('total_deductions', 0.0))" t-options='{"widget": "monetary", "display_currency": run.company_id.currency_id}'/></td>
                            </tr>
                        </table>

                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr style="background-color: #f5f5f5;">
                                    <th>Earnings</th>
                                    <th style="text-align: right;">Amount</th>
                                    <th>Deductions</th>
                                    <th style="text-align: right;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="earn_rows" t-value="bd.get('earnings', [])"/>
                                <t t-set="ded_rows" t-value="bd.get('deductions', [])"/>
                                <t t-set="max_rows" t-value="max(len(earn_rows), len(ded_rows))"/>
                                <t t-foreach="range(max_rows)" t-as="idx">
                                    <tr>
                                        <td><span t-if="idx &lt; len(earn_rows)" t-out="earn_rows[idx]['name']"/></td>
                                        <td style="text-align: right;">
                                            <span t-if="idx &lt; len(earn_rows)" t-out="earn_rows[idx]['amount']" t-options='{"widget": "monetary", "display_currency": run.company_id.currency_id}'/>
                                        </td>
                                        <td><span t-if="idx &lt; len(ded_rows)" t-out="ded_rows[idx]['name']"/></td>
                                        <td style="text-align: right;">
                                            <span t-if="idx &lt; len(ded_rows)" t-out="ded_rows[idx]['amount']" t-options='{"widget": "monetary", "display_currency": run.company_id.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="background-color: #f0f0f0; font-weight: bold;">
                                    <td>Total earnings</td>
                                    <td style="text-align: right;"><span t-out="bd.get('total_earnings', 0.0)" t-options='{"widget": "monetary", "display_currency": run.company_id.currency_id}'/></td>
                                    <td>Total deductions</td>
                                    <td style="text-align: right;"><span t-out="bd.get('total_deductions', 0.0)" t-options='{"widget": "monetary", "display_currency": run.company_id.currency_id}'/></td>
                                </tr>
                                <tr style="background-color: #d4edda; font-weight: bold;">
                                    <td colspan="3">Net pay</td>
                                    <td style="text-align: right;"><span t-out="(bd.get('total_earnings', 0.0) - bd.get('total_deductions', 0.0))" t-options='{"widget": "monetary", "display_currency": run.company_id.currency_id}'/></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_salary_breakdown" model="ir.actions.report">
        <field name="name">Salary Breakdown</field>
        <field name="model">hr.payslip.run</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zimbabwe_payroll.report_salary_breakdown_document</field>
        <field name="report_file">zimbabwe_payroll.report_salary_breakdown_document</field>
    </record>
</odoo>