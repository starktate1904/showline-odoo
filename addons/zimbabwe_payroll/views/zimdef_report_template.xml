<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_zimdef_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="run">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="company" t-value="run.company_id"/>
                        <t t-set="zimdef" t-value="(data or {}).get('zimdef', {})"/>

                        <h2 style="margin-top: 10px;">ZIMDEF Comprehensive Report</h2>
                        <p style="font-size: 12px; margin: 4px 0;">
                            Pay run: <span t-out="run.name"/> • Period: <span t-out="run.date_start"/> to <span t-out="run.date_end"/>
                        </p>

                        <table class="table table-sm" style="margin-bottom: 12px;">
                            <tr>
                                <td><strong>Employees:</strong> <span t-out="len(zimdef.get('employees', []))"/></td>
                                <td><strong>Basic salary total:</strong> <span t-out="zimdef.get('totals', {}).get('basic', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                <td><strong>Employer ZIMDEF total:</strong> <span t-out="zimdef.get('totals', {}).get('total_zimdef', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                <td><strong>Employer ZIMDEF on basic:</strong> <span t-out="zimdef.get('totals', {}).get('zimdef_employer', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                            </tr>
                        </table>

                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr style="background-color: #f5f5f5;">
                                    <th>Surname</th>
                                    <th>First Names</th>
                                    <th style="text-align: right;">Gross Wage</th>
                                    <th style="text-align: right;">ZIMDEF on Gross</th>
                                    <th style="text-align: right;">Total ZIMDEF Payment</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="zimdef.get('employees', [])" t-as="emp">
                                    <tr>
                                        <td><span t-out="emp.get('surname')"/></td>
                                        <td><span t-out="emp.get('first_names')"/></td>
                                        <td style="text-align: right;"><span t-out="emp.get('basic')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                        <td style="text-align: right;"><span t-out="emp.get('zimdef_employer')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                
                                        <td style="text-align: right;"><span t-out="emp.get('total_zimdef')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="background-color: #f0f0f0; font-weight: bold;">
                                    <td colspan="2">Grand Totals</td>
                                    <td style="text-align: right;"><span t-out="zimdef.get('totals', {}).get('basic', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                    <td style="text-align: right;"><span t-out="zimdef.get('totals', {}).get('zimdef_employer', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                    <td style="text-align: right;"><span t-out="zimdef.get('totals', {}).get('total_zimdef', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_zimdef" model="ir.actions.report">
        <field name="name">ZIMDEF Report</field>
        <field name="model">hr.payslip.run</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zimbabwe_payroll.report_zimdef_document</field>
        <field name="report_file">zimbabwe_payroll.report_zimdef_document</field>
    </record>
</odoo>