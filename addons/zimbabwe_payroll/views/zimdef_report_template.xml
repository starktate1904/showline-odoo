<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_zimdef_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="run">
                <t t-call="web.external_layout">
                    <div class="page article">
                        <t t-set="company" t-value="run.company_id"/>
                        <t t-set="zimdef" t-value="(data or {}).get('zimdef', {})"/>
                        
                        <div class="text-center mb-4 mt-2">
                            <h2 style="color: #2c3e50; font-weight: bold; border-bottom: 2px solid #2c3e50; padding-bottom: 10px; display: inline-block;">ZIMDEF Comprehensive Report</h2>
                            <h5 class="text-muted mt-3">
                                Pay Run: <span t-out="run.name" class="fw-bold text-dark"/>
                            </h5>
                            <h6 class="text-muted">
                                Period: <span t-out="run.date_start"/> to <span t-out="run.date_end"/>
                            </h6>
                            <p class="text-muted" style="font-size: 12px; margin-top: 10px;">
                                Generated on: <span t-out="zimdef.get('report_date', '')"/>
                            </p>
                        </div>

                        <table class="table table-sm table-bordered mt-4 zimra-table" style="font-size: 13px; width: 100%;">
                            <thead style="background-color: #2c3e50; color: #ffffff;">
                                <tr>
                                    <th class="align-middle">Surname</th>
                                    <th class="align-middle">First Names</th>
                                    <th class="align-middle text-end" style="width: 14%;">Gross Wage<br/>(USD)</th>
                                    <th class="align-middle text-end" style="width: 14%;">ZIMDEF on Gross<br/>(USD)</th>
                                    <th class="align-middle text-end" style="width: 14%;">NSSA+NEC<br/>Base (USD)</th>
                                    <th class="align-middle text-end" style="width: 14%;">ZIMDEF on Contribs<br/>(USD)</th>
                                    <th class="align-middle text-end" style="width: 14%;">Total ZIMDEF<br/>Payment (USD)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="zimdef.get('employees', [])" t-as="emp">
                                    <tr>
                                        <td class="align-middle"><span t-out="emp.get('surname')"/></td>
                                        <td class="align-middle"><span t-out="emp.get('first_names')"/></td>
                                        <td class="align-middle text-end">
                                            <span t-out="emp.get('gross')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                        <td class="align-middle text-end">
                                            <span t-out="emp.get('zimdef_on_gross')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                        <td class="align-middle text-end">
                                            <span t-out="emp.get('contribs_base')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                        <td class="align-middle text-end">
                                            <span t-out="emp.get('zimdef_on_contribs')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                        <td class="align-middle text-end fw-bold">
                                            <span t-out="emp.get('total_zimdef')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                                <tr style="background-color: #f1f5f9; font-weight: bold; border-top: 2px solid #2c3e50;">
                                    <td colspan="2" class="text-end pe-3 align-middle text-uppercase" style="color: #2c3e50;">Grand Totals</td>
                                    <t t-set="totals" t-value="zimdef.get('totals', {})"/>
                                    <td class="text-end align-middle">
                                        <span t-out="totals.get('gross', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                    </td>
                                    <td class="text-end align-middle" style="color: #047857;">
                                        <span t-out="totals.get('zimdef_on_gross', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                    </td>
                                    <td class="text-end align-middle">
                                        <span t-out="totals.get('contribs_base', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                    </td>
                                    <td class="text-end align-middle" style="color: #047857;">
                                        <span t-out="totals.get('zimdef_on_contribs', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                    </td>
                                    <td class="text-end align-middle" style="color: #1d4ed8; font-size: 14px;">
                                        <span t-out="totals.get('total_zimdef', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_zimdef" model="ir.actions.report">
        <field name="name">ZIMDEF Report</field>
        <field name="model">hr.payslip.run</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zimbabwe_payroll.report_zimdef_document</field>
        <field name="report_file">zimbabwe_payroll.report_zimdef_document</field>
    </record>
</odoo>
