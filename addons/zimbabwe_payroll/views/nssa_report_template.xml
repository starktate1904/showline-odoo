<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_nssa_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="run">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="company" t-value="run.company_id"/>
                        <t t-set="nssa" t-value="(data or {}).get('nssa', {})"/>
                        
                        <div class="text-center mb-4 mt-2">
                            <h2 style="color: #2c3e50; font-weight: bold; border-bottom: 2px solid #2c3e50; padding-bottom: 10px; display: inline-block;">NSSA Comprehensive Report</h2>
                            <h5 class="text-muted mt-3">
                                Pay Run: <span t-out="run.name" class="fw-bold text-dark"/>
                            </h5>
                            <h6 class="text-muted">
                                Period: <span t-out="run.date_start"/> to <span t-out="run.date_end"/>
                            </h6>
                            <p class="text-muted" style="font-size: 12px; margin-top: 10px;">
                                Generated on: <span t-out="nssa.get('report_date', '')"/>
                            </p>
                        </div>

                        <table class="table table-sm table-bordered mt-4" style="font-size: 13px; width: 100%;">
                            <thead style="background-color: #2c3e50; color: #ffffff;">
                                <tr>
                                    <th class="align-middle">Surname</th>
                                    <th class="align-middle">First Names</th>
                                    <th class="align-middle text-center">Start Date</th>
                                    <th class="align-middle text-center">End Date</th>
                                    <th class="align-middle text-end" style="width: 13%;">Total Insurable<br/>Earnings (USD)</th>
                                    <th class="align-middle text-end" style="width: 13%;">Employee<br/>Contributions (USD)</th>
                                    <th class="align-middle text-end" style="width: 13%;">Employer<br/>Contributions (USD)</th>
                                    <th class="align-middle text-end" style="width: 13%;">Total NSSA<br/>Payment (USD)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="nssa.get('employees', [])" t-as="emp">
                                    <tr>
                                        <td class="align-middle"><span t-out="emp.get('surname')"/></td>
                                        <td class="align-middle"><span t-out="emp.get('first_names')"/></td>
                                        <td class="align-middle text-center"><span t-out="emp.get('start_date')"/></td>
                                        <td class="align-middle text-center"><span t-out="emp.get('end_date')"/></td>
                                        <td class="align-middle text-end">
                                            <span t-out="emp.get('insurable_earnings')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                        <td class="align-middle text-end">
                                            <span t-out="emp.get('employee_nssa')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                        <td class="align-middle text-end">
                                            <span t-out="emp.get('employer_nssa')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                        <td class="align-middle text-end fw-bold">
                                            <span t-out="emp.get('total_nssa')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                                <tr style="background-color: #f1f5f9; font-weight: bold; border-top: 2px solid #2c3e50;">
                                    <td colspan="4" class="text-end pe-3 align-middle text-uppercase" style="color: #2c3e50;">Grand Totals</td>
                                    <t t-set="totals" t-value="nssa.get('totals', {})"/>
                                    <td class="text-end align-middle">
                                        <span t-out="totals.get('insurable_earnings', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                    </td>
                                    <td class="text-end align-middle" style="color: #047857;">
                                        <span t-out="totals.get('employee_nssa', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                    </td>
                                    <td class="text-end align-middle" style="color: #047857;">
                                        <span t-out="totals.get('employer_nssa', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                    </td>
                                    <td class="text-end align-middle" style="color: #1d4ed8; font-size: 14px;">
                                        <span t-out="totals.get('total_nssa', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_nssa" model="ir.actions.report">
        <field name="name">NSSA Report</field>
        <field name="model">hr.payslip.run</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zimbabwe_payroll.report_nssa_document</field>
        <field name="report_file">zimbabwe_payroll.report_nssa_document</field>
    </record>
</odoo>
