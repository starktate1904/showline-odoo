<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_nssa_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="run">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="company" t-value="run.company_id"/>
                        <t t-set="nssa" t-value="(data or {}).get('nssa', {})"/>
                        <t t-set="currency" t-value="run.slip_ids[:1].currency_id if run.slip_ids else run.company_id.currency_id"/>
                        <t t-set="currency" t-value="run.company_id.currency_id"/>
                        <t t-set="currency_name" t-value="currency.name"/>

                        <h2 style="margin-top: 10px;">NSSA Contribution Report</h2>
                        <p style="font-size: 12px; margin: 4px 0;">
                            Pay run: <span t-out="run.name"/> • Period: <span t-out="run.date_start"/> to <span t-out="run.date_end"/>
                        </p>

                        <table class="table table-sm" style="margin-bottom: 12px;">
                            <tr>
                                <td><strong>Employees:</strong> <span t-out="len(nssa.get('employees', []))"/></td>
                                <td><strong>Total basic salary:</strong> <span t-out="nssa.get('totals', {}).get('basic_salary', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                <td><strong>Employee contributions:</strong> <span t-out="nssa.get('totals', {}).get('employee_nssa', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                <td><strong>Total NSSA payment:</strong> <span t-out="nssa.get('totals', {}).get('total_nssa', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                            </tr>
                        </table>

                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr style="background-color: #f5f5f5;">
                                    <th>Surname</th><th>First Names</th>
                                    <th style="text-align:right;">Start Date</th><th style="text-align:right;">End Date</th>
                                    <th style="text-align:right;">Basic Salary (<span t-out="currency_name"/>)</th><th style="text-align:right;">Employee</th>
                                    <th style="text-align:right;">Employer</th><th style="text-align:right;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="nssa.get('employees', [])" t-as="emp">
                                    <tr>
                                        <td><span t-out="emp.get('surname')"/></td>
                                        <td><span t-out="emp.get('first_names')"/></td>
                                        <td style="text-align:right;"><span t-out="emp.get('start_date')"/></td>
                                        <td style="text-align:right;"><span t-out="emp.get('end_date')"/></td>
                                        <td style="text-align:right;"><span t-out="emp.get('basic_salary')" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                        <td style="text-align:right;"><span t-out="emp.get('employee_nssa')" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                        <td style="text-align:right;"><span t-out="emp.get('employer_nssa')" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                        <td style="text-align:right;"><span t-out="emp.get('total_nssa')" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="background-color: #f0f0f0; font-weight: bold;">
                                    <td colspan="4">Grand Totals</td>
                                    <td style="text-align:right;"><span t-out="nssa.get('totals', {}).get('basic_salary', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                    <td style="text-align:right;"><span t-out="nssa.get('totals', {}).get('employee_nssa', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                    <td style="text-align:right;"><span t-out="nssa.get('totals', {}).get('employer_nssa', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                    <td style="text-align:right;"><span t-out="nssa.get('totals', {}).get('total_nssa', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_nssa" model="ir.actions.report">
        <field name="name">NSSA Report</field>
        <field name="model">hr.payslip.run</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zimbabwe_payroll.report_nssa_document</field>
        <field name="report_file">zimbabwe_payroll.report_nssa_document</field>
    </record>
</odoo>