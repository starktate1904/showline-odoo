<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ddc" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.disallow.duplicate.contacts</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Disallow Duplicate Contacts" name="ddc_app">
                    
                    <!-- License Block -->
                    <block title="License Activation" name="ddc_license_block">
                        
                        <!-- License Status Indicator -->
                        <div class="d-flex align-items-center mb-3 p-3 rounded" 
                             style="background: #f8fafc; border: 1px solid #e2e8f0;">
                            <div class="me-3">
                                <field name="ddc_license_valid" 
                                       readonly="1" 
                                       widget="boolean_toggle"
                                       disabled="1"/>
                            </div>
                            <div>
                                <strong style="font-size: 15px; color: #1e293b;">License Status</strong>
                                <br/>
                                <span style="font-size: 13px; color: #64748b;">
                                    <field name="ddc_license_status" 
                                           readonly="1" 
                                           class="fw-bold"/>
                                </span>
                            </div>
                            <div class="ms-auto">
                                <span class="badge fs-6" 
                                      style="background-color: #10b981; color: white; padding: 8px 16px;"
                                      invisible="not ddc_license_valid">
                                    <i class="fa fa-shield-check me-1"/> Licensed &amp; Verified
                                </span>
                                <span class="badge fs-6" 
                                      style="background-color: #ef4444; color: white; padding: 8px 16px;"
                                      invisible="ddc_license_valid or not ddc_license_key">
                                    <i class="fa fa-shield-xmark me-1"/> Invalid License
                                </span>
                                <span class="badge fs-6" 
                                      style="background-color: #94a3b8; color: white; padding: 8px 16px;"
                                      invisible="ddc_license_valid or ddc_license_key">
                                    <i class="fa fa-shield me-1"/> Not Licensed
                                </span>
                            </div>
                        </div>
                        
                        <!-- License Key Input -->
                        <setting string="License Key" 
                                 help="Enter your license key in the format XXXX-XXXX-XXXX-XXXX. A valid license key is required to enable duplicate detection.">
                            <field name="ddc_license_key" 
                                   placeholder="XXXX-XXXX-XXXX-XXXX" 
                                   style="width: 280px; font-family: 'Courier New', monospace; font-size: 15px; letter-spacing: 2px; text-transform: uppercase; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 6px;"/>
                        </setting>
                        
                        <!-- Action Buttons -->
                        <div class="mt-3 mb-3 d-flex gap-2">
                            <button name="action_activate_disallow_duplicate_contacts_license" 
                                    type="object" 
                                    string="Validate &amp; Activate License" 
                                    class="btn btn-primary btn-lg"
                                    icon="fa-key"
                                    invisible="ddc_license_valid"/>
                            <button name="action_activate_disallow_duplicate_contacts_license" 
                                    type="object" 
                                    string="Re-validate License" 
                                    class="btn btn-outline-primary"
                                    icon="fa-refresh"
                                    invisible="not ddc_license_valid"/>
                        </div>
                        
                        <!-- Info -->
                        <div class="text-muted small mt-2">
                            <i class="fa fa-clock-o me-1"/>
                            License is automatically validated every 12 hours via a scheduled background job.
                        </div>
                        
                    </block>
                    
                    <!-- Detection Rules Block -->
                    <block title="Detection Rules" name="ddc_rules_block">
                        
                        <div class="text-muted mb-3">
                            <i class="fa fa-info-circle me-1"/>
                            Enable or disable individual detection rules. At least one rule must be active for duplicate detection to work.
                        </div>
                        
                        <setting string="Exact Name Only" 
                                 help="Matches contacts with an identical name (case-sensitive).">
                            <field name="ddc_check_name_exact"/>
                        </setting>
                        
                        <setting string="Email Only" 
                                 help="Matches contacts with the same email address.">
                            <field name="ddc_check_email_only"/>
                        </setting>
                        
                        <setting string="Name + Email" 
                                 help="Both the name and email must match an existing contact.">
                            <field name="ddc_check_email_name"/>
                        </setting>
                        
                        <setting string="Phone Only" 
                                 help="Matches contacts with the same phone number.">
                            <field name="ddc_check_phone_only"/>
                        </setting>
                        
                        <setting string="Name + Phone" 
                                 help="Both the name and phone number must match an existing contact.">
                            <field name="ddc_check_phone_name"/>
                        </setting>
                        
                        <setting string="Name + Street + City" 
                                 help="Name, street address, and city must all match an existing contact.">
                            <field name="ddc_check_name_address"/>
                        </setting>
                        
                    </block>
                    
                    <!-- About Block -->
                    <block title="About Disallow Duplicate Contacts" name="ddc_about_block">
                        
                        <div class="text-muted">
                            <p class="mb-3">
                                <strong>Disallow Duplicate Contacts</strong> prevents the creation of 
                                duplicate contacts using configurable matching rules. When a duplicate 
                                is detected, the user is redirected to the existing contact.
                            </p>
                            
                            <div class="row mb-3">
                                <div class="col-6">
                                    <p class="mb-2">
                                        <i class="fa fa-check-circle text-success me-2"/>
                                        6 configurable detection rules
                                    </p>
                                    <p class="mb-2">
                                        <i class="fa fa-check-circle text-success me-2"/>
                                        Real-time creation validation
                                    </p>
                                    <p class="mb-2">
                                        <i class="fa fa-check-circle text-success me-2"/>
                                        On-change preview warnings
                                    </p>
                                </div>
                                <div class="col-6">
                                    <p class="mb-2">
                                        <i class="fa fa-check-circle text-success me-2"/>
                                        Write &amp; quick-create checks
                                    </p>
                                    <p class="mb-2">
                                        <i class="fa fa-check-circle text-success me-2"/>
                                        Redirect to existing duplicate
                                    </p>
                                    <p class="mb-2">
                                        <i class="fa fa-check-circle text-success me-2"/>
                                        License protected
                                    </p>
                                </div>
                            </div>
                            
                            <hr/>
                            
                            <p class="mb-1">
                                <strong>Version:</strong> 19.0.1.0.0
                            </p>
                            <p class="mb-1">
                                <strong>Developed by:</strong> Showline Solutions
                            </p>
                            <p class="mb-0">
                                <strong>Website:</strong> showline.co.zw
                            </p>
                        </div>
                        
                    </block>
                    
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_ddc_open_duplicate_partner" model="ir.actions.act_window">
        <field name="name">Duplicate Contact</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('id', 'in', active_ids)]</field>
    </record>
</odoo>