<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_zimdef_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="run">
                <t t-call="zimbabwe_payroll.zw_report_minimal_wrap">
                    <t t-set="company" t-value="run.company_id"/>
                    <t t-set="zimdef" t-value="(data or {}).get('zimdef', {})"/>
                    <t t-call="zimbabwe_payroll.payroll_report_company_header"/>

                    <div class="zw-report-title">ZIMDEF Contribution Report</div>
                    <div class="zw-report-subtitle">Pay run: <span t-out="run.name"/> • Period: <span t-out="run.date_start"/> to <span t-out="run.date_end"/></div>

                    <div class="zw-card-grid">
                        <div class="zw-card-item">
                            <div class="zw-card-label">Employees</div>
                            <div class="zw-card-value"><span t-out="len(zimdef.get('employees', []))"/></div>
                        </div>
                        <div class="zw-card-item">
                            <div class="zw-card-label">Basic salary total</div>
                            <div class="zw-card-value"><span t-out="zimdef.get('totals', {}).get('basic', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></div>
                        </div>
                        <div class="zw-card-item">
                            <div class="zw-card-label">Employer ZIMDEF total</div>
                            <div class="zw-card-value"><span t-out="zimdef.get('totals', {}).get('total_zimdef', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></div>
                        </div>
                        <div class="zw-card-item">
                            <div class="zw-card-label">Employer ZIMDEF on basic</div>
                            <div class="zw-card-value"><span t-out="zimdef.get('totals', {}).get('zimdef_employer', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></div>
                        </div>
                    </div>

                    <table class="zw-table">
                        <thead>
                            <tr>
                                <th class="zw-left">Surname</th>
                                <th class="zw-left">First Names</th>
                                <th class="zw-right">Basic Salary</th>
                                <th class="zw-right">Employer ZIMDEF</th>
                                <th class="zw-right">Total ZIMDEF</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="zimdef.get('employees', [])" t-as="emp">
                                <tr t-attf-class="{'zw-alt-row' if emp_index % 2 else ''}">
                                    <td class="zw-left"><span t-out="emp.get('surname')"/></td>
                                    <td class="zw-left"><span t-out="emp.get('first_names')"/></td>
                                    <td class="zw-right"><span t-out="emp.get('basic')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                    <td class="zw-right"><span t-out="emp.get('zimdef_employer')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                    <td class="zw-right"><span t-out="emp.get('total_zimdef')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr class="zw-total-row">
                                <td colspan="2" class="zw-left">Grand Totals</td>
                                <td class="zw-right"><span t-out="zimdef.get('totals', {}).get('basic', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                <td class="zw-right"><span t-out="zimdef.get('totals', {}).get('zimdef_employer', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                <td class="zw-right"><span t-out="zimdef.get('totals', {}).get('total_zimdef', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                            </tr>
                        </tfoot>
                    </table>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_zimdef" model="ir.actions.report">
        <field name="name">ZIMDEF Report</field>
        <field name="model">hr.payslip.run</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zimbabwe_payroll.report_zimdef_document</field>
        <field name="report_file">zimbabwe_payroll.report_zimdef_document</field>
    </record>
</odoo>
