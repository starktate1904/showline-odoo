<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="zw_report_minimal_wrap">
        <div class="article">
            <div class="zw-page">
                <t t-raw="0"/>
            </div>
        </div>
    </template>

    <template id="report_payslip" inherit_id="hr_payroll.report_payslip">
        <xpath expr="//t[@t-call='web.external_layout']" position="attributes">
            <attribute name="t-call">zimbabwe_payroll.zw_report_minimal_wrap</attribute>
        </xpath>
        <xpath expr="//h2[@id='payslip_name']" position="replace"/>
        <xpath expr="//div[@id='infos_table']" position="replace">
            <div class="zw-report-header">
                <div class="zw-header-logo">
                    <img t-if="o.company_id.logo" class="zw-company-logo" t-att-src="image_data_uri(o.company_id.logo)"/>
                </div>
                <div class="zw-header-company">
                    <div class="zw-company-name"><span t-field="o.company_id.name"/></div>
                    <div t-if="o.company_id.street or o.company_id.street2">
                        <span t-field="o.company_id.street"/><t t-if="o.company_id.street2">, <span t-field="o.company_id.street2"/></t>
                    </div>
                    <div t-if="o.company_id.city or o.company_id.zip">
                        <span t-field="o.company_id.city"/> <span t-field="o.company_id.zip"/>
                    </div>
                    <div t-if="o.company_id.country_id"><span t-field="o.company_id.country_id"/></div>
                    <div t-if="o.company_id.phone or o.company_id.email or o.company_id.website">
                        <span t-field="o.company_id.phone"/>
                        <t t-if="o.company_id.phone and (o.company_id.email or o.company_id.website)"> | </t>
                        <span t-field="o.company_id.email"/>
                        <t t-if="o.company_id.email and o.company_id.website"> | </t>
                        <span t-field="o.company_id.website"/>
                    </div>
                </div>
            </div>
            <div class="zw-report-title">Salary Slip</div>
            <div class="zw-report-subtitle">
                <span t-out="o.employee_id.name"/> • Period: <span t-out="o.date_from"/> - <span t-out="o.date_to"/>
            </div>
            <t t-set="employee_identifier" t-value="o.employee_id.identification_id or o.employee_id.id"/>
            <table class="zw-info-table">
                <tr>
                    <td class="zw-label">Employee ID</td>
                    <td class="zw-value"><span t-out="employee_identifier"/></td>
                    <td class="zw-label">Name</td>
                    <td class="zw-value"><span t-field="o.employee_id.name"/></td>
                </tr>
                <tr>
                    <td class="zw-label">Department</td>
                    <td class="zw-value"><span t-out="o.employee_id.department_id.name or '-'"/></td>
                    <td class="zw-label">Designation</td>
                    <td class="zw-value"><span t-out="o.employee_id.job_title or '-'"/></td>
                </tr>
            </table>
        </xpath>
        <xpath expr="//div[@id='payslip_lines_table']/table" position="attributes">
            <attribute name="class">zw-table</attribute>
        </xpath>
        <xpath expr="//div[@id='payslip_lines_table']//thead//tr" position="replace">
            <tr>
                <th>EARNINGS</th>
                <th class="zw-right">AMOUNT</th>
                <th>DEDUCTIONS</th>
                <th class="zw-right">AMOUNT</th>
            </tr>
        </xpath>
        <xpath expr="//div[@id='to_pay']" position="replace"/>
        <xpath expr="//div[@id='payslip_lines_table']" position="after">
            <div class="zw-signatures">
                <div class="zw-signature">HR Signature</div>
                <div class="zw-signature">Employee Signature</div>
            </div>
        </xpath>
    </template>
</odoo>