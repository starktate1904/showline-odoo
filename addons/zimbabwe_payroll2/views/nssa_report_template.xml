<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_nssa_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="run">
                <t t-call="zimbabwe_payroll.zw_report_minimal_wrap">
                    <t t-set="company" t-value="run.company_id"/>
                    <t t-set="nssa" t-value="(data or {}).get('nssa', {})"/>
                    <t t-call="zimbabwe_payroll.payroll_report_company_header"/>

                    <div class="zw-report-title">NSSA Contribution Report</div>
                    <div class="zw-report-subtitle">Pay run: <span t-out="run.name"/> • Period: <span t-out="run.date_start"/> to <span t-out="run.date_end"/></div>

                    <div class="zw-card-grid">
                        <div class="zw-card-item">
                            <div class="zw-card-label">Employees</div>
                            <div class="zw-card-value"><span t-out="len(nssa.get('employees', []))"/></div>
                        </div>
                        <div class="zw-card-item">
                            <div class="zw-card-label">Total basic salary</div>
                            <div class="zw-card-value"><span t-out="nssa.get('totals', {}).get('basic_salary', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></div>
                        </div>
                        <div class="zw-card-item">
                            <div class="zw-card-label">Employee contributions</div>
                            <div class="zw-card-value"><span t-out="nssa.get('totals', {}).get('employee_nssa', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></div>
                        </div>
                        <div class="zw-card-item">
                            <div class="zw-card-label">Total NSSA payment</div>
                            <div class="zw-card-value"><span t-out="nssa.get('totals', {}).get('total_nssa', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></div>
                        </div>
                    </div>

                    <table class="zw-table">
                        <thead>
                            <tr>
                                <th class="zw-left">Surname</th>
                                <th class="zw-left">First Names</th>
                                <th class="zw-right">Start Date</th>
                                <th class="zw-right">End Date</th>
                                <th class="zw-right">Basic Salary</th>
                                <th class="zw-right">Employee</th>
                                <th class="zw-right">Employer</th>
                                <th class="zw-right">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="nssa.get('employees', [])" t-as="emp">
                                <tr t-attf-class="{'zw-alt-row' if emp_index % 2 else ''}">
                                    <td class="zw-left"><span t-out="emp.get('surname')"/></td>
                                    <td class="zw-left"><span t-out="emp.get('first_names')"/></td>
                                    <td class="zw-right"><span t-out="emp.get('start_date')"/></td>
                                    <td class="zw-right"><span t-out="emp.get('end_date')"/></td>
                                    <td class="zw-right"><span t-out="emp.get('basic_salary')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                    <td class="zw-right"><span t-out="emp.get('employee_nssa')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                    <td class="zw-right"><span t-out="emp.get('employer_nssa')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                    <td class="zw-right"><span t-out="emp.get('total_nssa')" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr class="zw-total-row">
                                <td colspan="4" class="zw-left">Grand Totals</td>
                                <td class="zw-right"><span t-out="nssa.get('totals', {}).get('basic_salary', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                <td class="zw-right"><span t-out="nssa.get('totals', {}).get('employee_nssa', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                <td class="zw-right"><span t-out="nssa.get('totals', {}).get('employer_nssa', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                                <td class="zw-right"><span t-out="nssa.get('totals', {}).get('total_nssa', 0)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></td>
                            </tr>
                        </tfoot>
                    </table>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_nssa" model="ir.actions.report">
        <field name="name">NSSA Report</field>
        <field name="model">hr.payslip.run</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zimbabwe_payroll.report_nssa_document</field>
        <field name="report_file">zimbabwe_payroll.report_nssa_document</field>
    </record>
</odoo>
